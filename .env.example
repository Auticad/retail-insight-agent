# Copia questo file in .env e personalizza i valori. Il file .env è escluso da Git.

# Database (docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/retail
DB_USER=retail
DB_PASSWORD=retail_dev

# Modello linguistico (guida E): Ollama in locale, API OpenAI-compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
